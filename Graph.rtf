In the case of a weighted directed graph, each node contains an extra field that is called the weight  of  the  node. In an adjacency list, it is easy to add a vertex. Because of using the linked list, it also saves space.\par
\b Implementation of adjacency matrix representation of Graph\par
\b0   \par
#include <stdio.h>  \par
#define V 4    /* number of vertices in the graph */  \par
  \par
/* function to initialize the matrix to zero */  \par
void init(int arr[][V]) \{  \par
  int i, j;  \par
  for (i = 0; i < V; i++)  \par
    for (j = 0; j < V; j++)  \par
      arr[i][j] = 0;  \par
\}  \par
  \par
/* function to add edges to the graph */  \par
void insertEdge(int arr[][V], int i, int j) \{  \par
  arr[i][j] = 1;  \par
  arr[j][i] = 1;  \par
\}  \par
  \par
/* function to print the matrix elements */  \par
void printAdjMatrix(int arr[][V]) \{  \par
  int i, j;  \par
  for (i = 0; i < V; i++) \{  \par
    printf("%d: ", i);  \par
    for (j = 0; j < V; j++) \{  \par
      printf("%d ", arr[i][j]);  \par
    \}  \par
    printf("\\n");  \par
  \}  \par
\}  \par
  \par
int main() \{  \par
  int adjMatrix[V][V];  \par
  \par
  init(adjMatrix);  \par
  insertEdge(adjMatrix, 0, 1);  \par
  insertEdge(adjMatrix, 0, 2);  \par
  insertEdge(adjMatrix, 1, 2);  \par
  insertEdge(adjMatrix, 2, 0);  \par
  insertEdge(adjMatrix, 2, 3);  \par
  \par
  printAdjMatrix(adjMatrix);  \par
  \par
  return 0;  \par
\}  \par
\b Implementation of adjacency list representation of Graph\par
\b0 /* Adjacency list representation of a graph in C */  \par
#include <stdio.h>  \par
#include <stdlib.h>  \par
  \par
/* structure to represent a node of adjacency list */  \par
struct AdjNode \{  \par
    int dest;  \par
    struct AdjNode* next;  \par
\};  \par
  \par
/* structure to represent an adjacency list */  \par
struct AdjList \{  \par
    struct AdjNode* head;  \par
\};  \par
  \par
/* structure to represent the graph */   \par
struct Graph \{  \par
    int V; /*number of vertices in the graph*/  \par
    struct AdjList* array;  \par
\};  \par
  \par
  \par
struct AdjNode* newAdjNode(int dest)  \par
\{  \par
    struct AdjNode* newNode = (struct AdjNode*)malloc(sizeof(struct AdjNode));  \par
    newNode->dest = dest;  \par
    newNode->next = NULL;  \par
    return newNode;  \par
\}  \par
  \par
struct Graph* createGraph(int V)  \par
\{  \par
    struct Graph* graph = (struct Graph*)malloc(sizeof(struct Graph));  \par
    graph->V = V;  \par
    graph->array = (struct AdjList*)malloc(V * sizeof(struct AdjList));  \par
  \par
    /* Initialize each adjacency list as empty by making head as NULL */  \par
    int i;  \par
    for (i = 0; i < V; ++i)  \par
        graph->array[i].head = NULL;  \par
    return graph;  \par
\}  \par
  \par
/* function to add an edge to an undirected graph */  \par
void addEdge(struct Graph* graph, int src, int dest)  \par
\{  \par
    /* Add an edge from src to dest. The node is added at the beginning */  \par
    struct AdjNode* check = NULL;  \par
    struct AdjNode* newNode = newAdjNode(dest);  \par
  \par
    if (graph->array[src].head == NULL) \{  \par
        newNode->next = graph->array[src].head;  \par
        graph->array[src].head = newNode;  \par
    \}  \par
    else \{  \par
  \par
        check = graph->array[src].head;  \par
        while (check->next != NULL) \{  \par
            check = check->next;  \par
        \}  \par
        // graph->array[src].head = newNode;  \par
        check->next = newNode;  \par
    \}  \par
  \par
    /* Since graph is undirected, add an edge from dest to src also */  \par
    newNode = newAdjNode(src);  \par
    if (graph->array[dest].head == NULL) \{  \par
        newNode->next = graph->array[dest].head;  \par
        graph->array[dest].head = newNode;  \par
    \}  \par
    else \{  \par
        check = graph->array[dest].head;  \par
        while (check->next != NULL) \{  \par
            check = check->next;  \par
        \}  \par
        check->next = newNode;  \par
    \}  \par
\}  \par
/* function to print the adjacency list representation of graph*/  \par
void print(struct Graph* graph)  \par
\{  \par
    int v;  \par
    for (v = 0; v < graph->V; ++v) \{  \par
        struct AdjNode* pCrawl = graph->array[v].head;  \par
        printf("\\n The Adjacency list of vertex %d is: \\n head ", v);  \par
        while (pCrawl) \{  \par
            printf("-> %d", pCrawl->dest);  \par
            pCrawl = pCrawl->next;  \par
        \}  \par
        printf("\\n");  \par
    \}  \par
\}  \par
  \par
int main()  \par
\{  \par
  \par
    int V = 4;  \par
    struct Graph* g = createGraph(V);  \par
    addEdge(g, 0, 1);  \par
    addEdge(g, 0, 3);  \par
    addEdge(g, 1, 2);  \par
    addEdge(g, 1, 3);  \par
    addEdge(g, 2, 4);  \par
    addEdge(g, 2, 3);  \par
    addEdge(g, 3, 4);  \par
    print(g);  \par
    return 0;  \par
\}  \par
